{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ecommercehub_dev;Username=postgres;Password=postgres;Include Error Detail=true;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "dev-secret-key-min-32-chars-long-dev-only",
    "Issuer": "EcommerceHub",
    "Audience": "EcommerceHub.Users",
    "AccessTokenExpiryMinutes": "60",
    "RefreshTokenExpiryDays": "30"
  }
}
